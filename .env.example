# Base do serviço
LICENCA_AMBIENTE=homologacao
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
LICENCA_PRIVADA_PEM=COLE_O_PEM_DA_CHAVE_DE_LICENCA_NO_COFRE
LICENCA_KEY_ID=homolog-ed25519-v1
LICENCA_PUBLICA_B64_ESPERADA=PUBLICA_DA_LICENCA
LICENCA_REPLICAS=1
ADMIN_TOKEN=SEGREDO_LEGADO_COM_PELO_MENOS_32_CARACTERES

# Recuperação: mantenha false até cliente, chave e OIDC estarem homologados
RECUPERACAO_HABILITADA=false
RECUPERACAO_PRIVADA_PEM=COLE_O_PEM_EXCLUSIVO_DA_RECUPERACAO_NO_COFRE
RECUPERACAO_KEY_ID=recuperacao-homolog-v2
RECUPERACAO_PUBLICA_B64_ESPERADA=PUBLICA_DA_RECUPERACAO
RECUPERACAO_TOKEN_TTL_SEGUNDOS=900
RECUPERACAO_RATE_MAX=5
RECUPERACAO_RATE_JANELA_S=3600
RECUPERACAO_DUPLA_APROVACAO=true

# OIDC Authorization Code + PKCE
OIDC_HABILITADO=true
OIDC_ISSUER=https://provedor.exemplo/tenant/v2.0
OIDC_AUTHORIZATION_ENDPOINT=https://provedor.exemplo/tenant/oauth2/v2.0/authorize
OIDC_TOKEN_ENDPOINT=https://provedor.exemplo/tenant/oauth2/v2.0/token
OIDC_JWKS_URI=https://provedor.exemplo/tenant/discovery/v2.0/keys
OIDC_CLIENT_ID=CLIENT_ID
OIDC_CLIENT_SECRET=CLIENT_SECRET
OIDC_REDIRECT_URI=https://licenca-homolog.exemplo/admin/callback
OIDC_SESSION_SECRET=SEGREDO_ALEATORIO_DE_ALTA_ENTROPIA_COM_32_OU_MAIS_CARACTERES
OIDC_EXIGIR_MFA=true
OIDC_GRUPO_LICENCAS_OPERADOR=ID_GRUPO_LICENCAS
OIDC_GRUPO_RECUPERACAO_OPERADOR=ID_GRUPO_RECUPERACAO_OPERADOR
OIDC_GRUPO_RECUPERACAO_APROVADOR=ID_GRUPO_RECUPERACAO_APROVADOR
OIDC_GRUPO_AUDITORIA_LEITURA=ID_GRUPO_AUDITORIA
